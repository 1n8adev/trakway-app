PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=trakway

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Website customers: access token lifetime and refresh token lifetime (days)
CUSTOMER_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Outgoing email for OTP codes (webmail / cPanel SMTP). Leave SMTP_HOST empty in development
# to print emails in the server console instead.
# Port 465 -> SMTP_SECURE=true (SSL); port 587 -> SMTP_SECURE=false (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Trakway <no-reply@yourdomain.com>"
# Who gets an email for every new order (comma-separated). Empty = nobody.
ADMIN_ORDER_EMAIL=

# Browser origins allowed to call the API (comma-separated). Leave empty to allow all (development).
# Production example: CORS_ORIGINS=https://trakway.in,https://www.trakway.in,https://admin.trakway.in
CORS_ORIGINS=
